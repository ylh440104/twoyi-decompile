<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.sixiang"
    android:versionCode="1"
    android:versionName="0.1">

    <!-- targetSdkVersion=28 is deliberate, and it is the single most important
         line in this file.

         Android 10+ enforces W^X on app data: files under /data/data/<pkg> are
         labelled app_data_file, and apps in the *current* untrusted_app domain
         may not execute them (execve -> EACCES, and mmap(PROT_EXEC) -> EACCES,
         which also blocks a guest linker from mapping its own libc).

         Apps that target API <= 28 keep running in untrusted_app_27, which is
         still allowed to execute app_data_file. That is exactly why Termux has
         refused to raise its targetSdk beyond 28 for years.

         We need it twice over:
           * mini_loader mmaps the guest's libc/linker out of filesDir, and
           * the guest's own linker64 mmaps every DT_NEEDED library.
         Both are PROT_EXEC mappings over app_data_file.

         minSdk 26 because Context#getFilesDir + ProcessBuilder + ART on the
         guest side all assume a reasonably modern platform. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <!-- extractNativeLibs=true is the second load-bearing line: it makes the
         system unpack lib/arm64-v8a/libmini_loader.so into nativeLibraryDir at
         install time, where the file is labelled apk_data_file -- a type the
         app may execute in every domain. That is the loader's primary path;
         mini_loader is also inside assets/guest.zip as a fallback. -->
    <application
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
